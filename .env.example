# ARAK Backend - Docker Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# SQL Server SA password (min 8 chars, upper+lower+digit+special)
MSSQL_SA_PASSWORD=your_strong_password_here

# JWT signing key (min 32 characters, cryptographically random)
JWT_KEY=your_jwt_secret_key_at_least_32_chars

# JWT settings
JWT_ISSUER=ArakAPI
JWT_AUDIENCE=ArakDashboard
JWT_EXPIRATION_HOURS=24

# CORS allowed origins
CORS_ORIGIN_1=http://localhost:5173
CORS_ORIGIN_2=http://localhost:5174
CORS_ORIGIN_3=http://localhost:3000

# Default seed password
ARAK_DEFAULT_PASSWORD=Admin@123

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development

# Port mappings
API_PORT=5000
SQL_SERVER_PORT=1433
